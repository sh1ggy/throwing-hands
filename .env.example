# Copy to .env (gitignored) and fill in. server/server.py reads it at start-up; shell variables win over it.

# Shared secret for --http (remote MCP, docs/remote-mcp.md). Make one with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
RPSBOT_TOKEN=

# Optional, same as the flags
# RPSBOT_LINK=auto          # auto | bridge | usb | serial
# RPSBOT_PORT=
# RPSBOT_BAUD=115200
# RPSBOT_HAND=auto          # auto | real | sim
# RPSBOT_SPEAK=0            # 1 = speak banter on the laptop (makes sound)
# RPSBOT_DATA=
