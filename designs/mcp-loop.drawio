<mxCell id="n11" value="&lt;b style='font-size:22px'&gt;RPS-Bot · the MCP loop&lt;/b&gt;&lt;span style='font-size:13px;color:#6B7280'&gt;  — invoke → set up → train → play → change the rules&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1200" height="34" as="geometry"/></mxCell>
