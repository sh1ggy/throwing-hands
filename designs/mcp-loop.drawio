<mxCell id="n32" value="&lt;b&gt;The prompt&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;“I'm bored… make up higher or lower, thumbs up = higher… teach yourself, then let's play.”&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E8A04A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="200" y="186" width="240" height="84" as="geometry"/></mxCell>
<mxCell id="n33" value="&lt;b&gt;Show your hand on cue&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;thumbs up · thumbs down · nothing&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E8A04A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="840" y="196" width="250" height="64" as="geometry"/></mxCell>
<mxCell id="n34" value="&lt;b&gt;Play&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;thumb up / down for each guess&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E8A04A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1210" y="196" width="230" height="64" as="geometry"/></mxCell>
<mxCell id="n35" value="&lt;b&gt;“Plot twist”&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;“thumbs down means higher”&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#E8A04A;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1550" y="190" width="210" height="76" as="geometry"/></mxCell>
<mxCell id="n36" value="&lt;b&gt;Connect&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;list_machines&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;server answers?&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBEAE3;strokeColor=#D97757;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="200" y="308" width="240" height="96" as="geometry"/></mxCell>
<mxCell id="n37" value="&lt;b&gt;Invent the game as JSON&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;machine_reference&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;define_machine(m, swap_gestures=true)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBEAE3;strokeColor=#D97757;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="308" width="310" height="96" as="geometry"/></mxCell>
<mxCell id="n38" value="&lt;b&gt;Drive training&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;train_gesture ×3 · read_gesture ×2&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;or the &lt;font face='Menlo' style='font-size:11px'&gt;show_train&lt;/font&gt; panel&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBEAE3;strokeColor=#D97757;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="840" y="308" width="250" height="96" as="geometry"/></mxCell>
<mxCell id="n39" value="&lt;b&gt;Start, then only watch&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;start_machine · machine_state · show_game&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBEAE3;strokeColor=#D97757;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1150" y="308" width="350" height="96" as="geometry"/></mxCell>
<mxCell id="n40" value="&lt;b&gt;Edit rules live&lt;/b&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;patch_machine&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;stop_machine&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBEAE3;strokeColor=#D97757;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1550" y="308" width="210" height="96" as="geometry"/></mxCell>
<mxCell id="n41" value="&lt;b&gt;Machine store&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;&lt;font face='Menlo' style='font-size:11px'&gt;&amp;lt;data&amp;gt;/machines/&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;fallback_machines/&lt;/font&gt;&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;fillColor=#EAF2FD;strokeColor=#4A86D9;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="205" y="520" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="n42" value="&lt;b&gt;Validator · machine.py&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;states · gestures · actions · safe expressions&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#4A86D9;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="480" y="446" width="310" height="74" as="geometry"/></mxCell>
<mxCell id="n43" value="&lt;b&gt;Gesture swap · gestures.py&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;name → camera ID&lt;/font&gt;&lt;br&gt;&lt;font face='Menlo' style='font-size:11px'&gt;up=1 · down=2 · nothing=3&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#E0A800;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="495" y="572" width="280" height="84" as="geometry"/></mxCell>
<mxCell id="n44" value="&lt;b&gt;Trainer&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;&lt;font face='Menlo' style='font-size:11px'&gt;train_gesture&lt;/font&gt;: countdown → N samples → learn(id)&lt;/font&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;&lt;font face='Menlo' style='font-size:11px'&gt;read_gesture&lt;/font&gt;: majority vote&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#4A86D9;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="840" y="446" width="250" height="104" as="geometry"/></mxCell>
<mxCell id="n45" value="&lt;b&gt;/train panel&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;MCP App in chat · same trainer&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#4A86D9;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="840" y="586" width="250" height="54" as="geometry"/></mxCell>
<mxCell id="n46" value="&lt;b&gt;Atomic patch&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;all ops validate or none apply · keeps state, vars, score&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF2FD;strokeColor=#4A86D9;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;spacing=6;shadow=0;" vertex="1" parent="1"><mxGeometry x="1550" y="446" width="210" height="104" as="geometry"/></mxCell>
<mxCell id="n47" value="&lt;b&gt;Why setup is the bottleneck&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7280' style='font-size:11px'&gt;&lt;b&gt;Manual / backup way:&lt;/b&gt; forget camera → &lt;font face='Menlo' style='font-size:11px'&gt;train_ui.py&lt;/font&gt; 3×15 per class → 30-throw test ≥ 85 % → save to SD. Minutes at a keyboard.&lt;br&gt;&lt;b&gt;Demo way:&lt;/b&gt; one prompt. The swap does the wipe and naming; then 3 short &lt;font face='Menlo' style='font-size:11px'&gt;train_gesture&lt;/font&gt; calls and 2 test reads. Target ≤ 35 s, hands off.&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fillColor=#FFFBEB;strokeColor=#E0A800;dashed=1;fontFamily=Helvetica;fontSize=12;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="200" y="660" width="250" height="160" as="geometry"/></mxCell>
<mxCell id="n48" value="&lt;b&gt;machine_runtime.py&lt;/b&gt;  &lt;font color='#6B7280' style='font-size:11px'&gt;background thread&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fillColor=#EAF7EE;strokeColor=#3FA15A;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="1140" y="440" width="370" height="382" as="geometry"/></mxCell>
<mxCell id="n49" value="&lt;font color='#6B7280' style='font-size:11px'&gt;events: &lt;/font&gt;&lt;font face='Menlo' style='font-size:11px'&gt;gesture:up / down · timer · enter · poke&lt;/font&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3FA15A;dashed=1;fontFamily=Helvetica;fontSize=11;fontColor=#1F2329;" vertex="1" parent="1"><mxGeometry x="1155" y="472" width="340" height="32" as="geometry"/></mxCell>
